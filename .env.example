# Copy to .env and fill in. .env is git-ignored and never committed.
# Keys can also be pasted into the app's Settings tab instead of using this file.

# Fish Audio — text-to-speech. Required.
# https://fish.audio  ->  account settings  ->  API keys
FISH_API_KEY=

# ONE of the following is required, for casting speakers and translating.
# OpenAI:  https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini:  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional. Where finished episodes are written.
# Default: ~/Peiyin Output
# PEIYIN_OUTPUT_DIR=
